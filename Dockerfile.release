# The release image: GoReleaser (dockers_v2 in .goreleaser.yaml) builds the binaries, the UI embedded, and puts
# each platform's under $TARGETPLATFORM/ in this build's context. The runtime matches the Dockerfile's final stage:
# keep the two in step. Labels come from .goreleaser.yaml.

# gcr.io/distroless/static-debian13:nonroot
FROM gcr.io/distroless/static-debian13:nonroot@sha256:aafe993665bf6200db38a02c11a9351e782a84b6a45e7f33b6695638c88e3931
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/millstream /millstream
WORKDIR /home/nonroot
ENV USER=millstream
USER 65532:65532
EXPOSE 7070
ENTRYPOINT ["/millstream"]
