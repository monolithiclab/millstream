# /etc/millstream/millstream.env: the engine's configuration, read by systemd (EnvironmentFile=) as root.
#   install -m 0600 -o root -g root millstream.env.example /etc/millstream/millstream.env
# Every setting of the environment file (spec section 14) is a MILLSTREAM_<SECTION>_<KEY> variable;
# `millstream init environment` lists them all. Generate each token with: openssl rand -hex 32 (at least 32
# characters, or the engine refuses to start).

# Postgres on this host. The password is libpq's PGPASSWORD, never part of the DSN; drop the three lines for SQLite
# in /var/lib/millstream.
MILLSTREAM_STORE_DSN=postgres://127.0.0.1/millstream?sslmode=disable
PGUSER=millstream
PGPASSWORD=change-me-postgres-password

MILLSTREAM_ENVIRONMENT=production
MILLSTREAM_AUTH_TOKEN=change-me-openssl-rand-hex-32-api-token
MILLSTREAM_NODE_TOKEN=change-me-openssl-rand-hex-32-node-token

# Optional: a reverse proxy's address, artifacts in S3, retention.
# MILLSTREAM_UI_BASE_URL=https://millstream.example
# MILLSTREAM_ARTIFACTS_URL=s3://millstream-artifacts
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MILLSTREAM_RETENTION_EVENTS=90d

# Each pipeline's secrets, one variable per secret name:
# MILLSTREAM_SECRET_PORTAL_TOKEN=change-me
