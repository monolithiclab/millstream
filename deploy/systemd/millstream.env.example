# /etc/millstream/millstream.env: the engine's secrets, read by systemd (EnvironmentFile=) as root.
#   install -m 0600 -o root -g root millstream.env.example /etc/millstream/millstream.env
# Generate each token with: openssl rand -hex 32
MILLSTREAM_DSN=postgres://millstream:change-me@127.0.0.1:5432/millstream?sslmode=disable
MILLSTREAM_TOKEN=change-me-api-token
MILLSTREAM_NODE_TOKEN=change-me-node-token
# Each pipeline's secrets, as the environment file's secrets block names them, e.g.:
# HOMESITE_TOKEN=change-me
