# /etc/millstream/node.env: a node's join URL and token, read by systemd (EnvironmentFile=) as root.
#   install -m 0600 -o root -g root node.env.example /etc/millstream/node.env
# The node token is the engines' node.token: at least 32 characters (openssl rand -hex 32).
MILLSTREAM_JOIN=https://millstream.example:7070
MILLSTREAM_NODE_TOKEN=change-me-openssl-rand-hex-32-node-token
