# Copy to .env (git-ignored) beside compose.yaml and replace every value. Compose reads .env for the ${…} in
# compose.yaml; nothing here is baked into an image or written to millstream.yaml.
# Generate each token and the password with: openssl rand -hex 32 (tokens: at least 32 characters, or the
# engines and nodes refuse to start).

# The image both engines and the nodes run: millstream:dev from make image, or a released
# ghcr.io/monolithiclab/millstream tag pinned by digest.
MILLSTREAM_IMAGE=millstream:dev

POSTGRES_PASSWORD=change-me-postgres-password

# The API bearer token (auth.token): every client and the UI's sign-in.
MILLSTREAM_TOKEN=change-me-openssl-rand-hex-32-api-token

# The node token (node.token): nodes present it to the engine. Rotating it disconnects every node.
MILLSTREAM_NODE_TOKEN=change-me-openssl-rand-hex-32-node-token
