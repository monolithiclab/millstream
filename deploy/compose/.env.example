# Copy to .env (git-ignored) beside compose.yaml and replace every value. Compose reads .env for the ${…} in
# compose.yaml; nothing here is baked into an image.
# Generate each token and the password with: openssl rand -hex 32 (tokens: at least 32 characters, or the
# engines and nodes refuse to start).

# The image both engines and the nodes run: millstream:dev from make image, or a released
# ghcr.io/monolithiclab/millstream tag pinned by digest.
MILLSTREAM_IMAGE=millstream:dev

# The Postgres password: the database is created with it, the engines connect with it (libpq's PGPASSWORD).
PGPASSWORD=change-me-postgres-password

# The API bearer token: every client and the UI's sign-in.
MILLSTREAM_AUTH_TOKEN=change-me-openssl-rand-hex-32-api-token

# The node token: nodes present it to the engine. Rotating it disconnects every node.
MILLSTREAM_NODE_TOKEN=change-me-openssl-rand-hex-32-node-token

# Optional: artifacts in an S3-compatible bucket shared by both engines, so a failover keeps them. Without these
# the active engine keeps them in the volume both engines share.
# MILLSTREAM_ARTIFACTS_URL=s3://millstream-artifacts
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=https://s3.fr-par.scw.cloud
